generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // NestJS/ts-node resuelven CommonJS: los imports internos no deben llevar extensión.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERADOR
  SUPERVISOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERADOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
