generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // NestJS/ts-node resuelven CommonJS: los imports internos no deben llevar extensión.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERADOR
  SUPERVISOR
  ADMIN
}

enum ResultadoGestion {
  SOLUCIONADO_MESA
  ENVIADO_SOPORTE2
  ESCALADO_NOC
  PENDIENTE_CLIENTE
  REAGENDADO
}

/// Canal por el que llegó/atendió la gestión (se muestra en el drawer del Historial).
enum CanalGestion {
  LLAMADA
  WHATSAPP
  TELEGRAM
}

enum CategoriaCanal {
  DEPORTES
  INFANTIL
  NOTICIAS
  DOCUMENTALES
  PREMIUM
  GENERAL
  MUSICA
}

enum EstadoCanal {
  OPERATIVO
  CAIDO
}

enum TipoIncidencia {
  SIN_SENAL
  VIDEO_PIXELADO
  IMAGEN_CONGELADA
  AUDIO_DESINCRONIZADO
  SENAL_INTERMITENTE
}

enum SeveridadIncidencia {
  CRITICA
  ALTA
  MEDIA
}

enum EstadoAtencion {
  SOLUCIONADO
  EN_PROCESO
  ESCALADO
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERADOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gestiones  Gestion[]
  atenciones AtencionApp[]
  /// Gestiones que este usuario editó (auditoría de `Gestion.updatedBy`).
  ediciones  Gestion[]     @relation("GestionEditor")
}

/// Una atención registrada por un operador de la mesa.
model Gestion {
  id         String           @id @default(uuid())
  operador   User             @relation(fields: [operadorId], references: [id])
  operadorId String
  resultado  ResultadoGestion
  motivo     String
  /// Zona del reporte (alimenta el heatmap del Análisis Mensual).
  ubicacion  String
  /// Día de operación, deliberadamente separado de `createdAt` (instante):
  /// la mesa cierra el día a una hora que no tiene por qué ser medianoche.
  fecha      DateTime         @db.Date
  createdAt  DateTime         @default(now())
  // ── Registro · Nueva Gestión ──
  // Texto NOT NULL con default '' para no romper el seed histórico (filas previas
  // sin estos campos) ni exigir un reseed: los inserts reales siempre los proveen.
  abonado        String       @default("")
  /// Nombre del cliente (Registro · Nueva Gestión). Opcional en la API.
  nombreCliente  String       @default("")
  telefono       String       @default("")
  detalle        String       @default("")
  solucion       String       @default("")
  tipo           String       @default("")
  requiereVisita Boolean      @default(false)
  observacion    String       @default("")
  /// Pin exacto 'lat, lng'; opcional (la zona vive en `ubicacion`).
  coordenadas    String?
  // ── Historial General ──
  /// Canal de la gestión (opcional; poblado por el seed histórico).
  canal          CanalGestion?
  /// Duración de la atención en minutos (opcional).
  duracion       Int?
  // ── Auditoría de edición (Historial · Editar gestión) ──
  // Ambos NULL a propósito: `null` = "nunca editada". Deliberadamente SIN
  // `@updatedAt` — debe reflejar solo ediciones explícitas, no cualquier escritura.
  updatedAt      DateTime?
  updatedBy      String?
  editor         User?         @relation("GestionEditor", fields: [updatedBy], references: [id])

  @@index([fecha])
  @@index([operadorId, fecha])
}

/// Bitácora de atención a reportes de clientes por la App Fibex (Fibex Play · Gestión).
model AtencionApp {
  id         String         @id @default(uuid())
  operador   User           @relation(fields: [operadorId], references: [id])
  operadorId String
  abonado    String // "Número de abonado" (texto: nombre/condominio/nº cuenta)
  canal      String // valor del catálogo de canales
  motivo     String // valor del catálogo de motivos
  solucion   String // valor del catálogo de soluciones
  estado     EstadoAtencion
  creadoEn   DateTime       @default(now())

  @@index([estado])
  @@index([canal])
}

/// Snapshot en vivo del estado de un canal de la grilla TV/streaming.
model Canal {
  id             String               @id @default(uuid())
  nombre         String
  categoria      CategoriaCanal
  estado         EstadoCanal          @default(OPERATIVO)
  tipoIncidencia TipoIncidencia? // solo si estado = CAIDO
  severidad      SeveridadIncidencia? // solo si estado = CAIDO
  detectadoEn    DateTime? // hora de la caída, solo si CAIDO
  orden          Int                  @default(0) // orden de presentación en la grilla
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([estado])
}
