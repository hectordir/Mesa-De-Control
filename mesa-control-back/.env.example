# Base de datos (docker-compose.yml levanta este Postgres, sin SSL)
# En Railway: referencia al plugin Postgres → ${{ Postgres.DATABASE_URL }}
# Si la URL trae `?sslmode=require` el adapter activa TLS automáticamente.
DATABASE_URL="postgresql://mesa:mesa@localhost:5432/mesa_control?schema=public"

# Secreto de firma de los JWT — obligatorio, la app no arranca sin él
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Entorno de ejecución. Con NODE_ENV=production Swagger (/api/docs) queda desactivado.
NODE_ENV="development"

# Puerto HTTP del backend. En Railway lo inyecta la plataforma: NO fijarlo a mano.
PORT=3000

# Orígenes permitidos por CORS. Admite lista separada por comas (se hace trim).
# Producción: CORS_ORIGIN="https://mesa-de-control.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# "true" para aceptar además los preview deploys https://*.vercel.app (default: cerrado)
# CORS_ALLOW_VERCEL_PREVIEWS="true"

# Solo para la ejecución única de `npm run bootstrap:admin` (primer usuario ADMIN).
# ADMIN_PASSWORD debe tener al menos 8 caracteres. Bórralas después del bootstrap.
# ADMIN_EMAIL="admin@fibex.com"
# ADMIN_PASSWORD="cambia-esta-contrasena"
# ADMIN_NAME="Administrador"

# Puerto host de Postgres si 5432 ya está ocupado en tu máquina
# POSTGRES_PORT=5433
