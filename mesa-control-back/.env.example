# Base de datos (docker-compose.yml levanta este Postgres)
DATABASE_URL="postgresql://mesa:mesa@localhost:5432/mesa_control?schema=public"

# Secreto de firma de los JWT — obligatorio, la app no arranca sin él
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Puerto HTTP del backend y origen permitido por CORS (front Vite)
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto host de Postgres si 5432 ya está ocupado en tu máquina
# POSTGRES_PORT=5433
